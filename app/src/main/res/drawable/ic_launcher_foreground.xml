<?xml version="1.0" encoding="utf-8"?>
<!--
    Drawn on Android's 108dp adaptive-icon canvas, centred on (54, 54). The face is deliberately
    modest (42dp across) because some launchers, OnePlus's included, enlarge the foreground layer,
    and a bigger face then fills the whole icon and loses its coloured margin.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Clock face. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,33 A21,21 0 1,1 54,75 A21,21 0 1,1 54,33 Z" />

    <!-- Hour hand (about 10) and minute hand (12): thick, with round ends. -->
    <path
        android:pathData="M54,54 L45.5,46.5"
        android:strokeColor="#FF3F51B5"
        android:strokeLineCap="round"
        android:strokeWidth="5.5" />
    <path
        android:pathData="M54,54 L54,39.5"
        android:strokeColor="#FF3F51B5"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <!-- Centre pin. -->
    <path
        android:fillColor="#FF3F51B5"
        android:pathData="M54,49.5 A4.5,4.5 0 1,1 54,58.5 A4.5,4.5 0 1,1 54,49.5 Z" />
</vector>
